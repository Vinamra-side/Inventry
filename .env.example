# External PostgreSQL connection string. Neon is a recommended free option.
# Use the pooled connection string from Neon when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Flask session signing key. Generate a long random value.
SECRET_KEY=change-this-to-a-random-string

# Set true only if you want the app to execute schema.sql on startup.
# Recommended: run schema.sql once in Neon, then leave this false.
INIT_SCHEMA=false
BOOTSTRAP_ADMIN=false

# Set true when serving over HTTPS (Vercel normally is HTTPS).
SESSION_COOKIE_SECURE=true

# One-time first login account. Set BOOTSTRAP_ADMIN=true only for the first
# deployment, sign in successfully, then return it to false and redeploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_DISPLAY_NAME=Saiko Admin

# Private machine-to-machine key shared only with the separate licensing backend.
LICENSING_INTEGRATION_KEY=replace-with-a-long-random-integration-key

# Direct Zoho invoice import (no connector/plugin). Use the domains for your
# Zoho data center; these defaults target India.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/inventory/v1
