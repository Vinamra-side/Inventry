# External PostgreSQL connection string. Neon is a recommended free option.
# Use the pooled connection string from Neon when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Flask session signing key. Generate a long random value.
SECRET_KEY=change-this-to-a-random-string

# Set true only if you want the app to execute schema.sql on startup.
# Recommended: run schema.sql once in Neon, then leave this false.
INIT_SCHEMA=false
BOOTSTRAP_ADMIN=false

# Set true when serving over HTTPS (Vercel normally is HTTPS).
SESSION_COOKIE_SECURE=true

# One-time first login account. Set BOOTSTRAP_ADMIN=true only for the first
# deployment, sign in successfully, then return it to false and redeploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_DISPLAY_NAME=Saiko Admin

# One fixed login used only by the dedicated Windows licence application.
LICENSE_ADMIN_USERNAME=saiko-owner
LICENSE_ADMIN_PASSWORD=replace-with-a-different-strong-password
LICENSE_OWNER_TOKEN_MAX_AGE=2592000
