# External PostgreSQL connection string. Neon is a recommended free option.
# Use the pooled connection string from Neon when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Flask session signing key. Generate a long random value.
SECRET_KEY=change-this-to-a-random-string

# Private admin URL key for /admin/license?key=...

# Set true only if you want the app to execute schema.sql on startup.
# Recommended: run schema.sql once in Neon, then leave this false.
INIT_SCHEMA=false

# Optional signed licensing. If either LICENSE_TOKEN or LICENSE_PUBLIC_KEY
# is set, the application requires a valid signed license token.
LICENSE_TOKEN=
LICENSE_PUBLIC_KEY=

# Set true when serving over HTTPS (Vercel normally is HTTPS).
SESSION_COOKIE_SECURE=true

# First login account. Created automatically only when app_users is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_DISPLAY_NAME=Saiko Admin
