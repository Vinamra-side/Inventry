# Local PostgreSQL connection used by docker-compose.yml.
# Override this with the provider's pooled TLS URL in deployed environments.
DATABASE_URL=postgresql://saiko_local:saiko_local_password@127.0.0.1:55432/saiko_inventory

# Local Compose database name.
LOCAL_POSTGRES_DB=saiko_inventory
# Local Compose database user.
LOCAL_POSTGRES_USER=saiko_local
# Obvious development-only database password; never reuse it in deployment.
LOCAL_POSTGRES_PASSWORD=saiko_local_password
# Deterministic loopback port; override this single value if 55432 is occupied.
LOCAL_POSTGRES_PORT=55432

# Flask session signing key. This obvious local-only value must be replaced in deployment.
SECRET_KEY=local-dev-secret-key-not-for-production

# Compose initializes schema.sql directly; leave app-side initialization disabled.
# Deployed environments should also apply schema.sql separately and keep this false.
INIT_SCHEMA=false
# Set true only for the one app start that should create the optional admin below.
BOOTSTRAP_ADMIN=false

# Local HTTP needs false; set true for every HTTPS deployment.
SESSION_COOKIE_SECURE=false

# Optional one-time bootstrap account. Set BOOTSTRAP_ADMIN=true for one local start only.
ADMIN_USERNAME=admin
# Obvious development-only password; replace it anywhere beyond local development.
ADMIN_PASSWORD=local-admin-password
# Display label for the optional bootstrap administrator.
ADMIN_DISPLAY_NAME=Saiko Admin

# Local-only machine key; replace with a long random shared secret in deployment.
LICENSING_INTEGRATION_KEY=local-licensing-integration-key

# Zoho OAuth client ID; intentionally blank because live Zoho is outside the local stack.
ZOHO_CLIENT_ID=
# Zoho OAuth client secret; intentionally blank locally.
ZOHO_CLIENT_SECRET=
# Zoho OAuth refresh token; intentionally blank locally.
ZOHO_REFRESH_TOKEN=
# Zoho Billing organization ID; intentionally blank locally.
ZOHO_ORGANIZATION_ID=
# Zoho webhook shared secret; intentionally blank locally.
ZOHO_WEBHOOK_SECRET=
# Zoho Accounts base URL; change both Zoho URLs together for another data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Zoho Billing v1 API base URL for the India data center.
ZOHO_API_BASE_URL=https://www.zohoapis.in/billing/v1

# Vercel injects these runtime/deployment markers; leave them blank locally.
VERCEL=
VERCEL_GIT_COMMIT_SHA=
VERCEL_DEPLOYMENT_ID=
